# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Random string; Vercel cron sends it as a bearer token to /api/keepalive
CRON_SECRET=change-me

# Optional: shows a small "Buy me a coffee or help with server costs" link in the footer.
NEXT_PUBLIC_DONATION_URL=
# Optional, server-only: Discord webhook for the /feedback form (create it in your #feedback channel).
DISCORD_FEEDBACK_WEBHOOK_URL=
# Optional, server-only: Ko-fi pings. Ko-fi -> Settings -> API: set the webhook URL to <site>/api/kofi and copy
# its verification token here; donations post to the Discord webhook in your #donations channel.
KOFI_VERIFICATION_TOKEN=
DISCORD_DONATIONS_WEBHOOK_URL=
