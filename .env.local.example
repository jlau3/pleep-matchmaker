# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Random string; Vercel cron sends it as a bearer token to /api/keepalive
CRON_SECRET=change-me

# Optional: shows a small "Buy me a coffee or help with server costs" link in the footer.
NEXT_PUBLIC_DONATION_URL=
# Optional, server-only: Discord webhook for the /feedback form (can be the same URL as the GitHub secret).
DISCORD_FEEDBACK_WEBHOOK_URL=
